<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>cn.yaowork.telegram-bridge</string>
  <key>ProgramArguments</key>
  <array>
    <!-- 把下面两行改成你自己的绝对路径 -->
    <string>/path/to/node</string>
    <string>/path/to/telegram-bridge/bridge.js</string>
  </array>
  <key>WorkingDirectory</key><string>/path/to/telegram-bridge</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>/path/to/telegram-bridge/launchd.out.log</string>
  <key>StandardErrorPath</key><string>/path/to/telegram-bridge/launchd.err.log</string>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
</dict>
</plist>
